<!DOCTYPE html>
<html>

<%- include('includes/head', {title: title}) %>

    <body>
        <div id="main-div">
            <%- include('./includes/header', {heading: title}) %>
                <main>
                    <div class="categoriesTable">

                        <% for(var i=0; i < data.length; i++) { %>
                            <div class="categories">
                                <a href="/categories/<%= data[i].categorySlug %>"><img alt="<%= data[i].categoryTitle %>" class="category-cover"
                                        src="<%=  data[i].categoryImg %>" width=90% height=80%>
                                    <br>
                                    <h1 class="category-heading">
                                        <%= data[i].categoryTitle %>
                                    </h1>
                                </a>
                            </div>
                            <% } %>   
                            <div class="categories">
                                <a href="/categories/new-category">
                                    <img class="category-cover" src="/plus.svg" width=90% height=80% >
                                    <br>
                                    <h1 class="category-heading">
                                        Add Category
                                    </h1>
                                </a>
                            </div>
                    </div>
                </main>
        </div>

        <%- include('./includes/sidebar') %>

            <script src="/script.js"></script>
    </body>

</html>