<!DOCTYPE html>
<html>

<%- include('../includes/head', {title: title}) %>

<body>
    <%- include('../includes/header', {heading: heading}) %>
    <div id="main-div">
        <main class="main">
            
            <form class="new-comic-form" action="/categories/<%= categorySlug %>/new-comic" method="POST">
                <h1><%= title %></h1>
                <p>
                    <label class="new-comic-form-label">Title*:</label>
                    <input class="new-comic-form-input" type="text" name="bookTitle" id="bookTitle" required />
                </p>
            </br>
            <p>
                <label class="new-comic-form-label">Page Slug*:</label>
                <input class="new-comic-form-input" type="text" name="slug" id="slug" required />
            </p>
        </br>
                <p>
                    <label class="new-comic-form-label">Item Image URL*:</label>
                    <input class="new-comic-form-input" type="text" name="bookImg" id="bookImg" required />
                </p>
            </br>
                <p>
                    <label class="new-comic-form-label">Number of Chapters*:</label>
                    <input class="new-comic-form-input" type="number" name="chapters" id="chapters" required min="0" step="1" />
                </p>
            </br>
                <p>
                    <label class="new-comic-form-label">Status*:</label>
                    <input class="new-comic-form-input" type="text" name="status" id="status" required />
                </p>
            </br>
                <p>
                    <label class="new-comic-form-label">Type*:</label>
                    <input class="new-comic-form-input" type="text" name="type" id="type" required />
                </p>
            </br>
                <p>
                    <label class="new-comic-form-label">Description*:</label>
                    <input class="new-comic-form-input" type="text" name="bookDescription" id="bookDescription" required />
                </p>
            </br>
                <p>
                    <button class="new-comic-form-button">Add Item</button>
                </p>
            </form>
        </main>
    </div>

    <%- include('../includes/sidebar') %>
    <script src="/script.js"></script>
</body>

</html>