<!DOCTYPE html>
<html>

<%- include('./includes/head', {title: title}) %>

<body id="body">
    <div id="main-div">
        <%- include('./includes/header', {heading: title}) %>
        <main class="main">
            <div class="main-table">
                <% for(var i=0; i < data.length; i++) { %>
                    <div class="books">
                        <!-- <% console.log(data[i].slug) %> -->
                        <a href="/categories/<%= categorySlug %>/<%= data[i].slug %>"><img class="book-cover"
                            src="<%= data[i].bookImg %>"
                            width=194px height=261px></a>
                    </div>
                <% } %>
                <div class="books">
                    <a href="/categories/<%= categorySlug %>/new-item">Add Item<img class="book-cover"
                        src="/plus.svg"
                        width=194px height=261px></a>
                </div>
                <div class="books">
                    <a href="/categories/<%= categorySlug %>/edit">Edit <%= categoryTitle%><img class="book-cover"
                        src="/edit.svg"
                        width=194px height=261px></a>
                </div>
                <div class="books">
                    <a href="/categories/<%= categorySlug %>/delete">Delete <%= categoryTitle%><img class="book-cover"
                        src="/delete.svg"
                        width=194px height=261px></a>
                </div>
            </div>
        </main>
    </div>
    
    <%- include('./includes/sidebar') %>
    <script src="/script.js"></script>

</body>

</html>