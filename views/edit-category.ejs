<!DOCTYPE html>
<html>

<%- include('./includes/head', {title: title}) %>

    <body>
        <%- include('./includes/header', {heading: heading}) %>
            <div id="main-div">
                <main class="main">

                    <form class="new-comic-form" action="/categories/<%= categorySlug %>/edit" method="POST">
                        <h1>
                            <%= title %>
                        </h1>
                        <p>
                            <label class="new-comic-form-label">Category Title*:</label>
                            <input class="new-comic-form-input" value="<%= comic.categoryTitle %>" type="text" name="categoryTitle" id="categoryTitle" required />
                        </p>
                        </br>
                        <p>
                            <label class="new-comic-form-label">Page Slug*:</label>
                            <input class="new-comic-form-input" value="<%= comic.categorySlug %>" type="text" name="categorySlug" id="categorySlug" required />
                        </p>
                        </br>
                        <p>
                            <label class="new-comic-form-label">Category Image URL*:</label>
                            <input class="new-comic-form-input" value="<%= comic.categoryImg %>" type="text" name="categoryImg" id="categoryImg" required />
                        </p>
                        </br>
                        <p>
                            <label class="new-comic-form-label">Category Page Title*:</label>
                            <input class="new-comic-form-input" value="<%= comic.categoryPageTitle %>" type="text" name="categoryPageTitle" id="categoryPageTitle"
                                required />
                        </p>
                        </br>
                        <p>
                            <button type="submit" class="new-comic-form-button">Save Changes</button>
                        </p>
                    </form>
                </main>
            </div>

            <%- include('./includes/sidebar') %>
                <script src="/script.js"></script>
    </body>

</html>